/*
 * Correzione UI v6.1 per tredicesima, quattordicesima e quindicesima.
 *
 * Questo file viene caricato DOPO app.js e svolge due funzioni:
 * 1. aggiorna la descrizione visibile delle mensilita aggiuntive;
 * 2. sostituisce il contenuto del popup audit per chiarire che le addizionali
 *    regionali e comunali restano nel calcolo annuo e non sono sottratte
 *    direttamente dalla singola mensilita aggiuntiva.
 *
 * Il valore numerico corretto arriva da calcolo.js v6.1.
 */

(function () {
  "use strict";

  function formatoEuro(valore) {
    return Number(valore || 0).toLocaleString("it-IT", {
      style: "currency",
      currency: "EUR",
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  }

  function aggiornaDescrizioneMensilitaAggiuntive() {
    const descrizione = document.getElementById("descExtra");
    if (!descrizione) return;

    const htmlCorrente = descrizione.innerHTML;
    const primaRiga = htmlCorrente.split("<br>")[0];

    descrizione.innerHTML =
      primaRiga +
      "<br><small>senza detrazioni da lavoro; addizionali nel totale annuo</small>";
  }

  function recuperaUltimoRisultato() {
    /*
     * ULTIMO e dichiarato con let in app.js e quindi non e una proprieta
     * di window. Per questo il fix legge i valori gia mostrati nella pagina
     * e ricostruisce il dettaglio usando gli output esposti dal motore.
     *
     * Se app.js espone in futuro window.ULTIMO, viene usato direttamente.
     */
    if (window.ULTIMO) return window.ULTIMO;
    return null;
  }

  function mostraAuditCorretto(evento) {
    const icona = evento.target.closest('.info[data-audit="mensExtra"]');
    if (!icona) return;

    evento.preventDefault();
    evento.stopImmediatePropagation();

    const risultato = recuperaUltimoRisultato();
    const popover = document.getElementById("auditPopover");
    const titolo = document.getElementById("auditTitle");
    const corpo = document.getElementById("auditBody");
    const fonte = document.getElementById("auditFonte");

    if (!popover || !titolo || !corpo || !fonte) return;

    titolo.textContent = "Mensilita aggiuntive";

    if (risultato) {
      corpo.innerHTML =
        "La tredicesima, la quattordicesima e l'eventuale quindicesima " +
        "non beneficiano delle detrazioni da lavoro dipendente.<br><br>" +
        "In questa rappresentazione non viene sottratta direttamente " +
        "una quota di addizionale regionale o comunale dalla mensilita " +
        "aggiuntiva. Le addizionali sono calcolate sul reddito annuo e " +
        "restano gia comprese nel netto annuo complessivo.<br><br>" +
        "<code>" + formatoEuro(risultato.lordoMese) +
        " - " + formatoEuro(risultato.contrMese) +
        " - " + formatoEuro(risultato.irpefMese) +
        " = " + formatoEuro(risultato.nettoMensilitaAggiuntiva) +
        "</code>";
    } else {
      corpo.innerHTML =
        "La tredicesima, la quattordicesima e l'eventuale quindicesima " +
        "non beneficiano delle detrazioni da lavoro dipendente.<br><br>" +
        "Le addizionali regionale e comunale sono calcolate sul reddito " +
        "annuo e non vengono sottratte direttamente dalla singola " +
        "mensilita aggiuntiva.<br><br>" +
        "<code>Lordo mensilita - contributi INPS - IRPEF</code>";
    }

    fonte.textContent =
      "Fonte: art. 50 D.Lgs. 446/1997 per l'addizionale regionale; " +
      "art. 1 D.Lgs. 360/1998 per l'addizionale comunale";

    popover.style.display = "block";

    const rect = icona.getBoundingClientRect();
    const larghezza = 320;
    let left = rect.left + window.scrollX - larghezza / 2 + 8;

    left = Math.max(
      10,
      Math.min(
        left,
        window.scrollX + document.documentElement.clientWidth - larghezza - 10
      )
    );

    popover.style.left = left + "px";
    popover.style.top = rect.bottom + window.scrollY + 8 + "px";
  }

  /*
   * L'evento e registrato in fase capture per precedere il vecchio listener
   * definito in app.js.
   */
  document.addEventListener("click", mostraAuditCorretto, true);

  /*
   * app.js ricrea il contenuto di descExtra dopo ogni calcolo.
   * Il MutationObserver riapplica automaticamente la descrizione corretta.
   */
  const observer = new MutationObserver(function () {
    aggiornaDescrizioneMensilitaAggiuntive();
  });

  function avviaObserver() {
    const descrizione = document.getElementById("descExtra");
    if (!descrizione) return;

    observer.observe(descrizione, {
      childList: true,
      subtree: true,
      characterData: true
    });

    aggiornaDescrizioneMensilitaAggiuntive();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", avviaObserver);
  } else {
    avviaObserver();
  }
})();
